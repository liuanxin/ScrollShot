<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="@string/app_name" android:icon="@drawable/ic_capture"
        android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <!-- 用户要求 Kotlin 原生截图工具, 不使用跨端框架或 Launcher 入口. -->
        <receiver android:name=".ShareReceiver" android:exported="false" />
        <provider android:name=".ShareProvider" android:authorities="${applicationId}.share"
            android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".ShareCleanupService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <activity android:name=".SetupActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".CaptureEntryActivity" android:taskAffinity="" android:exported="false" android:excludeFromRecents="true" android:theme="@style/TransparentTheme" android:noHistory="true" />
        <activity android:name=".EditorActivity" android:configChanges="orientation|screenSize|keyboardHidden" android:taskAffinity="io.github.liuanxin.scrollshot.editor" android:exported="false" android:excludeFromRecents="true" />
        <service android:name=".CaptureTileService" android:exported="true" android:icon="@drawable/ic_capture"
            android:label="@string/app_name" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <service android:name=".CaptureService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
